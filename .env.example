# ════════════════════════════════════════════════════════════════════════════
# brahma-web environment — copy to `.env.local` (local) and into Vercel
# (Project → Settings → Environment Variables). Save as UTF-8, not UTF-16.
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase dashboard → project "BRAHMAS Website" → Project Settings → API Keys.
# Both are PUBLIC by design (row-level security limits them to reading published
# content), so they are filled in here. Never put the "secret" / "service_role"
# key in this file or anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=https://dynxjlgdoftzgfsuezwc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gmUzBErZDiOwO0mql6sPlg_DlWzzPIE

# ── Keep-alive cron (Vercel only) ────────────────────────────────────────────
# Any long random string; Vercel sends it to /api/keepalive so the free Supabase
# project never pauses. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Google Places (scripts/enrich-properties.mjs only — the site never reads it)
# Google Cloud console → APIs & Services → Credentials. Keep it secret.
GOOGLE_MAPS_API_KEY=
